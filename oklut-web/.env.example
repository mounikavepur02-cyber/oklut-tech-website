# Copy this file to .env and fill in your values
# Keys are in Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://jypnyiqtbvnmwbiawrlz.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# AI Chatbot configuration (backend only - Hugging Face Open-Source Model)
HF_TOKEN=hf_your_hugging_face_token_here
AI_PROVIDER=huggingface
AI_MODEL=Qwen/Qwen2.5-72B-Instruct
AI_FALLBACK_MODELS=Qwen/Qwen2.5-Coder-32B-Instruct,Qwen/Qwen2.5-7B-Instruct
AI_BASE_URL=https://router.huggingface.co/v1/chat/completions

# Google Cloud Translation API key (backend only — never exposed to browser)
# Get one at: https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here